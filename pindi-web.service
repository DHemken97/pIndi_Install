[Unit]
Description=PiNDI web administration
# Not needed for the picture: start after the player so it never delays it.
After=network.target pindi.service pindi-webd.service
Wants=pindi-webd.service
StartLimitIntervalSec=0

[Service]
Type=simple
# The network-facing front end (HTTPS, pages, uploads): unprivileged. It reads the device's state and asks
# pindi-webd.service for every change. Groups: pindi-media (NDI config), video (capture modes, throttling),
# systemd-journal (logs page).
User=pindi-web
Group=pindi-web
ExecStart=/usr/bin/python3 /usr/local/lib/pindi/pindi-web.py
# Only to listen on ports 80 and 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# pindi-web: preview requests for the player.
RuntimeDirectory=pindi-web
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
