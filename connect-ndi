#!/bin/bash

TARGET="OUT_$(tr -d '\0' < /sys/firmware/devicetree/base/serial-number)"
SPLASH="/usr/share/plymouth/themes/pindi/splash.png"
SPLASH_PID=""

show_splash() {
    if [ -z "$SPLASH_PID" ] || ! kill -0 "$SPLASH_PID" 2>/dev/null; then
        /usr/bin/fbi -T 1 -d /dev/fb0 -noverbose -a "$SPLASH" &
        SPLASH_PID=$!
        sleep 1
    fi
}

hide_splash() {
    if [ -n "$SPLASH_PID" ]; then
        kill "$SPLASH_PID" 2>/dev/null || true
        wait "$SPLASH_PID" 2>/dev/null || true
        SPLASH_PID=""
    fi
}

cleanup() {
    hide_splash
}
trap cleanup EXIT TERM INT

while true; do
    SOURCE=$(/usr/bin/ndiclient 2>/dev/null |
        grep -F "($TARGET)" |
        head -n 1)

    if [ -n "$SOURCE" ]; then
        DEVICE="${SOURCE% ($TARGET)}"
        echo "Connecting to $DEVICE ($TARGET)..."

        hide_splash
        /usr/bin/ndiclient --fullscreen "$DEVICE" "$TARGET"

        echo "NDI viewer exited. Restoring splash..."
    else
        echo "Stream $TARGET not found. Showing splash..."
        show_splash
        sleep 2
    fi
done