#!/usr/bin/python3

from PIL import Image, ImageDraw, ImageFont
import socket
import subprocess

SOURCE = "/usr/share/pindi/splash.jpg"
OUTPUT = "/usr/share/pindi/splash-live.jpg"

image = Image.open(SOURCE).convert("RGB")
draw = ImageDraw.Draw(image)

font_path = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
font_size = max(16, image.width // 50)

try:
    font = ImageFont.truetype(font_path, font_size)
except OSError:
    font = ImageFont.load_default()

hostname = socket.gethostname()

try:
    addresses = subprocess.check_output(
        ["hostname", "-I"], text=True
    ).split()
    ip = addresses[0] if addresses else "Waiting for network"
except Exception:
    ip = "Waiting for network"

try:
    with open(
        "/sys/firmware/devicetree/base/serial-number", "rb"
    ) as f:
        serial = f.read().decode("ascii", errors="ignore").strip("\x00\r\n ")
except OSError:
    serial = "Unknown"

lines = [
    f"{hostname} | IP: {ip}",
    f"Serial: {serial}"
]

margin = max(20, image.width // 40)
line_height = max(24, font_size + 10)
panel_height = 2 * margin + len(lines) * line_height

text_width = max(
    draw.textbbox((0, 0), line, font=font)[2]
    for line in lines
)

x1 = margin
y1 = image.height - margin - panel_height
x2 = min(image.width - margin, x1 + text_width + 2 * margin)
y2 = image.height - margin

draw.rectangle((x1, y1, x2, y2), fill=(0, 0, 0))

for index, line in enumerate(lines):
    draw.text(
        (x1 + margin, y1 + margin + index * line_height),
        line,
        font=font,
        fill=(255, 255, 255)
    )

image.save(OUTPUT, quality=95)
