[Unit]
Description=PiNDI Boot Splash
After=local-fs.target
Before=ndi-receiver.service

[Service]
Type=simple
ExecStartPre=/usr/local/bin/pindi-splash-render
ExecStart=/usr/bin/fbi -T 1 -d /dev/fb0 -noverbose -a /usr/share/pindi/splash-live.jpg
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
